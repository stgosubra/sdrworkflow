# hubspot-notes-sweep environment template
# Copy to `.env` locally. Do not commit real values.

# Modjo
MODJO_USER_ID=0000                              # the single Modjo userId the sweep acts on
MCP_MODJO=mcp__xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx  # MCP server slug for Modjo tools

# HubSpot
HUBSPOT_PORTAL_ID=0000000                       # HubSpot portal/hub id
HUBSPOT_OWNER_ID=00000000                       # HubSpot ownerId the AE operates under
MCP_HUBSPOT=mcp__xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Slack
SLACK_NOTES_CHANNEL=C00000000                   # Slack channel id for the Notes notifier
SLACK_WEBHOOK_PATH=~/.claude/secrets/slack-webhook-notes  # file containing the webhook URL

# AE identity
AE_NAME="First Last"
AE_EMAIL=first.last@example.com

# Timezone
TZ=Europe/Madrid
